# 复制本文件为 config.yaml 并填写参数
# 敏感信息也可通过环境变量覆盖：API_ID / API_HASH / STRING_SESSION

telegram:
  api_id: 6627460
  api_hash: "your_api_hash"
  string_session: "your_string_session"
  forward_to_channel: "your_channel"
  target_channel: "your_channel"   # 链接检测目标频道，可与 forward_to_channel 相同

monitor:
  # 监控频道列表，支持扩展语法：
  #   频道名|20          — 自定义最近消息数
  #   频道名|reply_1     — 监控评论，最近 1 条评论
  #   频道名|reply_1_20  — 监控评论 + 最近 20 条频道消息
  channels:
    - "Quark_Movies|20"
    - "DuanJuQuark|reply_1"
  limit: 20                        # 默认监控最近消息数
  check_replies: false
  replies_limit: 1
  try_join: false
  only_today: true
  incremental: true                # 增量监听：仅处理新消息（推荐开启）
  past_years: false

filters:
  include:
    - "链接"
    - "片名"
    - "magnet"
    - "pan.quark.cn"
    - "aliyundrive.com"
    - "夸克云盘"
    - "阿里云盘"
  exclude:
    - "小程序"
    - "预告"
    - "电子书"
    - "课程"
    - "短剧"
    - "音乐"
    - "mp3"

dedup:
  checknum: 50                     # 首次去重检测条数，当日转发超出后自动扩展

# 超链接文字 → 替换为真实 URL（按网盘分类）
hyperlink_text:
  quark: ["😀 Quark", "夸克网盘", "@@"]
  aliyun: ["😀 Alipan", "阿里云盘", "@@"]
  baidu: ["😀 Baidu", "百度网盘", "@@"]
  magnet: ["点击查看", "@@"]
  ed2k: ["点击查看", "@@"]
  "115": ["😀 115", "115网盘", "@@"]
  tianyi: ["直达链接", "@@"]
  uc: ["UC网盘", "@@"]
  "123": ["点击查看", "@@"]
  others: ["点击查看", "@@"]

# 消息关键字替换：目标词 → [要被替换的词列表]
replacements:
  your_channel: ["旧频道名1", "旧频道名2"]
  "": ["via 匿名", "广告合作"]

# 置顶统计消息（Markdown）
message_md: |
  **今日资源自动聚合更新**

# 按关键词分发到不同频道（不需要则留空 []）
channel_match: []
# channel_match:
#   - include: ["pan.quark.cn"]
#     exclude: ["mp3"]
#     target: "quark_channel"

# 代理（不需要则注释掉）
# proxy:
#   type: SOCKS5
#   host: 127.0.0.1
#   port: 7897
#   username:
#   password:

link_checker:
  delete_mode: 2                   # 1:检测并删除  2:仅检测标记  3:删除已标记失效
  limit: 1000
  concurrency: 20
  recheck: true
  json_path_normal: "messages.json"
  json_path_123: "messages_123.json"
  batch_size: 500
  net_disk_domains:
    - "pan.quark.cn"
    # - "aliyundrive.com"
    # - "alipan.com"

logging:
  level: INFO

history_file: "history.json"
